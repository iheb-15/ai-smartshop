# --- IA (Anthropic Claude) ---
# Sans clé, la plateforme fonctionne en mode dégradé : chatbot à règles, recherche par règles + TF-IDF,
# analyse d'avis lexicale. Recommandation et prédiction (scikit-learn) ne dépendent pas de la clé.
ANTHROPIC_API_KEY=your_api_key_here
# Modèle Claude (repli automatique sur d'autres modèles si celui-ci est indisponible pour la clé)
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Sécurité ---
JWT_SECRET=change_this_to_a_random_secret

# --- Base de données ---
# Laisser vide pour utiliser backend/shop.db (chemin absolu, indépendant du dossier de lancement).
# Exemple PostgreSQL : postgresql+psycopg2://user:pass@localhost:5432/neoshop
DATABASE_URL=

# --- CORS (origines du frontend, séparées par des virgules) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
